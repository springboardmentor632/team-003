{
  "info": {
    "name": "DecisionHub API",
    "_postman_id": "decisionhub-collection",
    "description": "Basic tests for auth and user profile endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api" },
    { "key": "token", "value": "" },
    { "key": "test_email", "value": "test.user@example.com" },
    { "key": "test_password", "value": "Password123" }
  ],
  "item": [
    {
      "name": "Register - success",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\"\n}"
        }
      }
    },
    {
      "name": "Register - duplicate (expect 409)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/register",
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\"\n}" }
      }
    },
    {
      "name": "Login - success",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/login",
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\"\n}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "pm.environment.set('token', json.token);",
              "pm.test('token present', () => pm.expect(json.token).to.exist);"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Profile (authorized)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/users/profile"
      }
    },
    {
      "name": "Update Profile (authorized)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/users/profile",
        "body": { "mode": "raw", "raw": "{ \n  \"name\": \"Test User Updated\" \n}" }
      }
    },
    {
      "name": "Get Users (ADMIN only)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/admin/users"
      }
    }
  ]
}
