    {
      "name": "2. Decisions, Options & Voting",
      "item": [
        {
          "name": "Get Public Decisions (Paginated)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/decisions/public?page=0&size=20"
          }
        },
        {
          "name": "Get My Decisions (Paginated)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/decisions/mine?page=0&size=20"
          }
        },
        {
          "name": "Get All Decisions",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/decisions"
          }
        },
        {
          "name": "Get Decision by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/decisions/1"
          }
        },
        {
          "name": "Get Community Decisions",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/decisions/community/1"
          }
        },
        {
          "name": "Create Decision Board",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Database caching strategy\",\n  \"description\": \"Compare Redis Cluster vs Hazelcast for session and query caching.\",\n  \"category\": \"Technology\",\n  \"visibility\": \"PUBLIC\",\n  \"pollType\": \"SINGLE_CHOICE\",\n  \"allowAnonymousVoting\": false,\n  \"options\": [\n    {\n      \"title\": \"Redis Cluster\",\n      \"description\": \"Managed Redis with sub-millisecond reads\",\n      \"pros\": \"Fast, widely adopted\",\n      \"cons\": \"Memory cost\",\n      \"costScore\": 7,\n      \"benefitsScore\": 9,\n      \"riskScore\": 8,\n      \"timeScore\": 9,\n      \"convenienceScore\": 9\n    },\n    {\n      \"title\": \"PostgreSQL Read Replicas\",\n      \"description\": \"Scale reads without a separate cache layer\",\n      \"pros\": \"No cache invalidation\",\n      \"cons\": \"Higher latency than in-memory\",\n      \"costScore\": 8,\n      \"benefitsScore\": 7,\n      \"riskScore\": 9,\n      \"timeScore\": 8,\n      \"convenienceScore\": 8\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/decisions"
          }
        },
        {
          "name": "Update Decision Board",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Admin: Cloud migration\",\n  \"description\": \"Choose the best path for the next platform infrastructure move.\",\n  \"category\": \"Technology\",\n  \"visibility\": \"PUBLIC\",\n  \"pollType\": \"SINGLE_CHOICE\",\n  \"closed\": false\n}"
            },
            "url": "{{baseUrl}}/api/decisions/1"
          }
        },
        {
          "name": "Get Options for Decision",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/decisions/1/options"
          }
        },
        {
          "name": "Add Option to Decision",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Hybrid Multi-Cloud\",\n  \"description\": \"Split workloads across Azure and AWS\",\n  \"pros\": \"No vendor lock-in\",\n  \"cons\": \"Higher operational complexity\",\n  \"costScore\": 5,\n  \"benefitsScore\": 8,\n  \"riskScore\": 7,\n  \"timeScore\": 6,\n  \"convenienceScore\": 6\n}"
            },
            "url": "{{baseUrl}}/api/decisions/1/options"
          }
        },
        {
          "name": "Cast Vote on Decision",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"optionId\": 1,\n  \"rating\": 5\n}"
            },
            "url": "{{baseUrl}}/api/decisions/1/votes"
          }
        },
        {
          "name": "Get Vote Results for Decision",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/decisions/1/votes/results"
          }
        },
        {
          "name": "Retract Vote on Decision",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/decisions/1/votes/1"
          }
        }
      ]
    },
    {
