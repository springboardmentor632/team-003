# ==============================================================================
# DecisionHub Environment Configuration Template (.env.example)
# Copy this file to .env and configure values before launching containers:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Name of the database to create/connect to
POSTGRES_DB=decisionhub

# Database master username
POSTGRES_USER=decisionhub

# Strong database password (REQUIRED - generate with `openssl rand -base64 24`)
POSTGRES_PASSWORD=replace-with-a-long-secure-database-password

# Optional: Host port if exposing PostgreSQL directly (default in compose is internal)
POSTGRES_PORT=5432

# Connection pool sizing
DB_MAX_POOL_SIZE=20

# ------------------------------------------------------------------------------
# 2. APPLICATION SECURITY & SECRETS
# ------------------------------------------------------------------------------
# Minimum 256-bit secret key for signing JWT tokens (REQUIRED)
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-base64-jwt-secret-minimum-256-bits

# JWT token expiration in milliseconds (86400000 = 24 hours)
JWT_EXPIRATION=86400000

# Active Spring Profile (prod, dev, test)
SPRING_PROFILES_ACTIVE=prod

# ------------------------------------------------------------------------------
# 3. SMTP & EMAIL NOTIFICATIONS (Password Reset & Alerts)
# ------------------------------------------------------------------------------
# Outgoing SMTP mail server hostname (e.g. smtp.sendgrid.net, smtp.mailgun.org)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true

# Sender address shown on password reset emails
PASSWORD_RESET_FROM=no-reply@decisionhub.org

# Full frontend URL where reset token links will point
PASSWORD_RESET_URL=http://localhost/reset-password

# ------------------------------------------------------------------------------
# 4. NETWORK, PORTS & CORS
# ------------------------------------------------------------------------------
# External HTTP port mapped by Docker Compose (default: 80)
APP_PORT=80

# External HTTPS/SSL port mapped by docker-compose.prod.yml (default: 443)
APP_SSL_PORT=443

# Comma-separated list of allowed origins for Cross-Origin Resource Sharing
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1,http://127.0.0.1:80,https://decisionhub.org

# ------------------------------------------------------------------------------
# 5. FRONTEND VITE CONFIGURATION
# ------------------------------------------------------------------------------
# API Base URL for React frontend client (default "/" routes through Nginx proxy)
VITE_API_BASE_URL=/

# ------------------------------------------------------------------------------
# 6. LOGGING & OBSERVABILITY
# ------------------------------------------------------------------------------
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
LOG_PATH=/app/logs
