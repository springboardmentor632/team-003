# PostgreSQL (default runtime)
DB_URL=jdbc:postgresql://localhost:5432/decisionhub
DB_USERNAME=decisionhub
DB_PASSWORD=change-me

# App secrets
JWT_SECRET=replace-with-a-long-random-secret-in-production
JWT_EXPIRATION=86400000

# Optional MySQL profile: set SPRING_PROFILES_ACTIVE=mysql
MYSQL_URL=jdbc:mysql://localhost:3306/decisionhub?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
MYSQL_USERNAME=decisionhub
MYSQL_PASSWORD=change-me

# SMTP password-reset delivery
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
PASSWORD_RESET_FROM=no-reply@example.com
PASSWORD_RESET_URL=http://127.0.0.1:3000/reset-password
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
